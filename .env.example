DATABASE_URL=postgresql+psycopg://ledgerx:ledgerx_local@localhost:5432/ledgerx
ENABLE_DEV_FUNDING=false
TOKEN_LIFETIME_SECONDS=3600
AUTH_ATTEMPTS_PER_PEER=10
AUTH_ATTEMPTS_TOTAL=120
AUTH_WINDOW_SECONDS=60
AUTH_MAX_CONCURRENT=2
# Public hosting uses a separate TLS database; local development leaves this false.
PUBLIC_DEMO=false
# Only used to provision/login to the isolated ledgerx_bench database.
BENCHMARK_PASSWORD=ledgerx-local-benchmark-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
